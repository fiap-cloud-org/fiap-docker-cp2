# Copie para .env e troque as senhas: cp .env.example .env
COMPOSE_PROJECT_NAME=fiap-docker-cp2

MYSQL_ROOT_PASSWORD=troque-a-senha-root
MYSQL_DATABASE=mysql_db
MYSQL_USER=app_user
MYSQL_PASSWORD=troque-a-senha-da-app

# Portas no host
APP_PORT=5000
MYSQL_HOST_PORT=3307

# Nome da imagem gerada pelo build (para docker push, use <seu-usuario>/meu-microservico)
IMAGE_NAME=local/meu-microservico
IMAGE_TAG=latest
